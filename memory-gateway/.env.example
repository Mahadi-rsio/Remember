# App
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Trace logging (context sent to AI + response received)
# LOG_FILE=./logs/gateway.log
LOG_BODIES=true
LOG_PAYLOAD_MAX_BYTES=100000

# Upstream main AI (mandatory for answers)
UPSTREAM_PROVIDER=openai
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# Optional Memory AI compressor (never answers the user)
MEMORY_AI_ENABLED=false
MEMORY_AI_PROVIDER=openrouter
MEMORY_AI_BASE_URL=https://openrouter.ai/api/v1
MEMORY_AI_MODEL=cheap-model
MEMORY_AI_API_KEY=
MEMORY_AI_TIMEOUT=30.0
MEMORY_AI_RETRY_ONCE=true

# Context compiler budget (tokens)
CONTEXT_BUDGET=8000

# SQLite (MVP — no Redis/vector DB required)
SQLITE_PATH=./data/memory.db
# REDIS_URL=

# Gateway auth hook (optional; Phase 7)
# GATEWAY_API_KEY=
MAX_REQUEST_BYTES=2000000
